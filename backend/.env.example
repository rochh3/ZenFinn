PORT=3000
NODE_ENV=production

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo para el webhook de WhatsApp. NUNCA en la app móvil.
SUPABASE_SERVICE_ROLE_KEY=

# IA (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# WhatsApp Cloud API (opcional)
WHATSAPP_TOKEN=
VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Orígenes CORS permitidos, separados por comas (vacío = ninguno)
CORS_ORIGINS=
